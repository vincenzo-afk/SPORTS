# The checked-in provider is fully local and requires no third-party credentials.
SPORTS_PROVIDER=demo

# Live Tennis API (https://livetennisapi.com) — set SPORTS_PROVIDER=livetennis to
# select the adapter in server/sports/liveTennisProvider.ts. The key is read on the
# server only and never reaches the browser. Leaving these unset keeps the demo feed.
#
# The free plan (no card) covers live matches, upcoming fixtures, match detail and
# the tournament catalogue at 30 requests per minute and 100 per day. Completed
# matches need BASIC, the match timeline and the rankings table PRO, and in-play
# statistics ULTRA; below those plans the adapter simply omits that data.
# SPORTS_PROVIDER=livetennis
# LIVETENNIS_API_KEY=your-live-tennis-api-key
# Optional: override only to point at a non-production host.
# LIVETENNIS_API_BASE_URL=https://api.livetennisapi.com/api/public/v1

# Configure the OAuth, database, and platform runtime variables described in README.md
# when self-hosting the complete authentication-enabled application.
